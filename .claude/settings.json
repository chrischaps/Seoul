{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/issue-session.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/issue-guard.sh\"",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/issue-guard.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
